# EMAIL SENDING — Gmail API (the only mailer; works on Render free via HTTPS 443).
# One-time setup: run `python gmail_setup.py` on your PC to mint the refresh token.
# 1) Google Cloud Console → enable Gmail API
# 2) Credentials → Create OAuth Client ID → Desktop app → copy client id/secret
# 3) OAuth consent screen → Publishing status = In production (keeps token from expiring)
# 4) python gmail_setup.py  (saves the refresh token it prints here)
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=1//generated_token_from_gmail_setup
GMAIL_USER=ahamedshamin5@gmail.com
EMAIL_FROM=ahamedshamin5@gmail.com
EMAIL_FROM_NAME=Shamim Ahamed J

# --- Brevo (legacy/unused — kept as a sample credential block only) ---
# BREVO_API_KEY=your_brevo_api_key_here

# Applicant Details
YOUR_NAME=Shamim Ahamed J
YOUR_PHONE=9894593190
YOUR_EMAIL=ahamedshamin5@gmail.com

# Backend
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# API security: leave empty for local dev (open access).
# Set a strong random value when deployed — every /api/* call requires it.
#   (extension settings / scripts use it as X-API-Key header)
# API_TOKEN=change-me-to-a-long-random-string

# Dashboard login (personal). APP_PASSWORD empty = dashboard stays open locally.
# Set both when deployed — this is the real login page (no raw token prompt).
# APP_USERNAME=shamim
# APP_PASSWORD=change-me-to-a-strong-password
# SESSION_SECRET=change-me-to-a-long-random-secret

# Database: defaults to SQLite (job_automation.db). Set for Postgres on Render:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Groq LLM (optional — improves extraction of weak/image posts + drafts emails)
# Get a key at https://console.groq.com/keys. When missing, everything still
# works with the built-in regex/OCR heuristics.
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b